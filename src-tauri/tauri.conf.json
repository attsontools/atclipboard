{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "剪贴板",
  "version": "0.1.0-alpha.0",
  "identifier": "com.attson.clipboard",
  "build": {
    "beforeDevCommand": "pnpm stage:service && pnpm dev",
    "devUrl": "http://127.0.0.1:1429",
    "beforeBuildCommand": "pnpm build && pnpm stage:service --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "剪贴板",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "resizable": true
      },
      {
        "label": "history",
        "title": "剪贴板历史",
        "url": "history.html",
        "width": 980,
        "height": 300,
        "minWidth": 720,
        "minHeight": 260,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      },
      {
        "label": "preview",
        "title": "剪贴板预览",
        "url": "preview.html",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "nsis"],
    "externalBin": ["binaries/atclipboard-service"]
  },
  "plugins": {}
}
